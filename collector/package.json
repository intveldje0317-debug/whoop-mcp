{
  "name": "whoop-mcp-telemetry-collector",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir build",
    "build:dashboard": "WRANGLER_SEND_METRICS=false wrangler deploy --config wrangler.dashboard.json --dry-run --outdir build/dashboard",
    "lint": "eslint src/ tests/",
    "format:check": "prettier --check src/ tests/ dashboard/ *.ts *.json *.mjs"
  },
  "dependencies": {
    "jose": "6.2.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260919.1",
    "miniflare": "5.20260911.1-alpha",
    "wrangler": "4.131.2"
  }
}
