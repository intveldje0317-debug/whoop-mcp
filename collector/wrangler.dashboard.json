{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "whoop-mcp-dashboard",
  "main": "src/dashboard-entry.mjs",
  "compatibility_date": "2026-09-15",
  "account_id": "00000000000000000000000000000000",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "logpush": false,
  "observability": {
    "enabled": false,
    "logs": { "enabled": false, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "vars": { "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "", "OWNER_EMAIL": "" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whoop-mcp-telemetry",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html", "**/*.css", "**/dashboard/app.js"],
      "fallthrough": true
    }
  ]
}
